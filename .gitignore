# .gitignore
# 依赖
node_modules/
.pnp
.pnp.js

# 测试
coverage/

# 运行环境
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 操作系统
.DS_Store
*.swp
*.swo
*~

# IDE
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 构建产物（我们使用预构建的 dist 目录）
# dist/  # 注释掉，因为我们要在 Git 中保留 dist

# 本地数据库（避免提交到 Git）
data/

# 环境变量
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# npm
package-lock.json
yarn.lock
pnpm-lock.yaml
*.lock

# History
.history/

# 压缩包
*.zip
*.tar.gz
